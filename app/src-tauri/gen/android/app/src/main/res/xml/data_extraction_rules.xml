<?xml version="1.0" encoding="utf-8"?>
<!-- 2bf review finding 10: android:allowBackup="false" stops cloud backup, but Android 12+ still copies
     app data in a device-to-device transfer unless excluded here. The recent-files list (names, URIs)
     and its thumbnails never leave the phone. NOTE: under gen/android; restore after `tauri android init`. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="gl_recents.xml" />
        <exclude domain="file" path="gl_thumbs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gl_recents.xml" />
        <exclude domain="file" path="gl_thumbs/" />
    </device-transfer>
</data-extraction-rules>
